// Generated by mazapan (plugin {{ plugin }}).
//
// One app in the dock: its icon, a mark under it for each window (up to
// three), its name above it while the pointer rests on it.
//   click         no window: open it; one: go to it; several: pick one
//   middle click  a new window
//   right click   its menu (its own actions, keep in the dock, close)
//   wheel         its windows one after the other

import QtQuick
import QtQuick.Effects
import Quickshell
import Quickshell.Widgets
import qs
import "Apps.js" as Apps

Item {
  id: button

  required property var item // { app, pinned, windows, focused }
  required property int size

  readonly property var entry: DockService.entry(item.app)
  readonly property string name: DockService.name(item.app)
  readonly property string icon: Quickshell.iconPath(entry ? entry.icon : item.app, true)
  // While its menu or its windows are out, the dock stays.
  readonly property bool busy: picker.visible || menu.visible

  implicitWidth: size + 8
  implicitHeight: size + 12

  // Where a point of this button is on the desktop. The dock is anchored
  // to the bottom of its screen.
  function desktopPoint(x, y) {
    const win = QsWindow.window
    const p = mapToItem(win.contentItem, x, y)
    return Qt.point(win.screen.x + p.x, win.screen.y + win.screen.height - win.height + p.y)
  }

  function activate() {
    const windows = item.windows
    if (windows.length === 0) DockService.launch(item.app)
    else if (windows.length === 1) DockService.focus(windows[0])
    else picker.toggle()
  }

  Rectangle {
    anchors.fill: parent
    radius: Theme.radius
    color: area.containsMouse || button.busy ? Theme.surface : "transparent"
  }

  // In the theme's colors (the icons setting): each icon in one hue, as
  // the bar's glyphs are, its light and dark kept so it's still told apart.
  // The hue says how the app is: dim while it has no window, brighter while
  // it has, the accent while it has the focus. A tint is the brightest an
  // icon gets, so in a light theme, whose text is near black, the tints
  // are its mid tones: with the text's color an icon would be a dark blot.
  readonly property bool themed: DockService.settings.icons === "theme"
  readonly property bool light: Theme.mode === "light"
  readonly property color tint: item.focused ? (light ? Theme.accent : Theme.accentText)
    : item.windows.length > 0 ? (light ? Theme.fgSubtle : Theme.fg)
    : (light ? Qt.lighter(Theme.fgSubtle, 1.3) : Theme.fgMuted)

  IconImage {
    id: image
    visible: button.icon !== ""
    x: 4
    y: 3
    implicitSize: button.size
    source: button.icon
    asynchronous: true

    layer.enabled: button.themed
    layer.effect: MultiEffect {
      colorization: 1
      colorizationColor: button.tint
      Behavior on colorizationColor {
        enabled: Theme.motion
        ColorAnimation { duration: Theme.duration }
      }
    }
  }

  // No icon: its first letter, so it's still told apart.
  Rectangle {
    visible: button.icon === ""
    x: 4
    y: 3
    width: button.size
    height: button.size
    radius: Theme.radius
    color: Theme.surfaceRaised
    border.color: Theme.border
    border.width: 1

    Text {
      anchors.centerIn: parent
      text: button.name.charAt(0).toUpperCase()
      color: Theme.fgMuted
      font.family: Theme.fontUi
      font.pointSize: button.size / 3
    }
  }

  // A mark for each window; the accent while one of them has the focus.
  Row {
    anchors.horizontalCenter: parent.horizontalCenter
    anchors.bottom: parent.bottom
    anchors.bottomMargin: 2
    spacing: 3

    Repeater {
      model: Math.min(button.item.windows.length, 3)

      Rectangle {
        width: button.item.focused ? 8 : 4
        height: 3
        radius: Math.min(Theme.radius, 1.5)
        color: button.item.focused ? Theme.accent : Theme.fgMuted

        Behavior on width {
          enabled: Theme.motion
          NumberAnimation { duration: Theme.duration; easing.type: Easing.OutQuint }
        }
      }
    }
  }

  MouseArea {
    id: area
    anchors.fill: parent
    hoverEnabled: true
    acceptedButtons: Qt.LeftButton | Qt.MiddleButton | Qt.RightButton

    onClicked: mouse => {
      if (mouse.button === Qt.MiddleButton) DockService.newWindow(button.item.app)
      else if (mouse.button === Qt.RightButton) menu.toggle()
      else button.activate()
    }

    // A wheel notch is 120; a touchpad sends many small steps, added up so
    // a swipe moves one window, not ten.
    property real wheelSum: 0
    onWheel: wheel => {
      wheelSum += wheel.angleDelta.y
      if (Math.abs(wheelSum) < 120) return
      const next = Apps.step(button.item.windows, wheelSum < 0 ? 1 : -1)
      wheelSum = 0
      if (next) DockService.focus(next, button.desktopPoint(wheel.x, wheel.y))
    }
  }

  // Its name, above it, once the pointer has rested a moment.
  Timer {
    id: rest
    interval: 350
    running: area.containsMouse && !button.busy
  }
  PopupWindow {
    visible: area.containsMouse && !rest.running && !button.busy
    anchor.item: button
    anchor.edges: Edges.Top
    anchor.gravity: Edges.Top
    implicitWidth: label.implicitWidth + 16
    implicitHeight: label.implicitHeight + 8 + Theme.gapOut
    color: "transparent"

    Rectangle {
      width: parent.width
      height: parent.height - Theme.gapOut
      color: Theme.surfaceRaised
      border.color: Theme.border
      border.width: 1
      radius: Theme.radius

      Text {
        id: label
        anchors.centerIn: parent
        text: button.name
        textFormat: Text.PlainText
        color: Theme.fg
        font.family: Theme.fontUi
        font.pointSize: Theme.fontSize - 1
      }
    }
  }

  WindowPicker {
    id: picker
    owner: button
    windows: button.item.windows
  }

  AppMenu {
    id: menu
    owner: button
    item: button.item
    entry: button.entry
  }
}
