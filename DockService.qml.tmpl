// Generated by mazapan (plugin {{ plugin }}).
//
// The dock's state for the whole shell, however many screens show it: its
// settings, which app each window belongs to, the apps in the order the
// dock shows them, and what can be done with them. What it decides is in
// Apps.js; this file joins those decisions to Quickshell and Hyprland.
pragma Singleton

import QtQuick
import Quickshell
import Quickshell.Io
import Quickshell.Hyprland
import qs
import "Apps.js" as Apps

Singleton {
  id: root

  // The settings, from the file mazapan writes when they change: read live,
  // so a change (pinning an app) doesn't reload the shell. The defaults
  // hold until it's read.
  readonly property var settings: Object.assign({
    visibility: "smart", icon_size: 44, pinned: [], this_screen_only: true, launcher: true, icons: "theme"
  }, stored)
  property var stored: ({})

  FileView {
    path: Quickshell.shellPath("components/dock/settings.json")
    blockLoading: true
    watchChanges: true
    printErrors: false
    onFileChanged: reload()
    onLoaded: {
      try {
        root.stored = JSON.parse(text())
        root.pinnedNow = null
      } catch (e) {}
    }
  }

  // A pin changed from the dock shows at once, while mazapan writes it to
  // the settings file (a few seconds: apply renders every plugin); the
  // file's list then takes over.
  property var pinnedNow: null
  readonly property var pinned: pinnedNow ?? settings.pinned

  // --- which app a window belongs to ---------------------------------------

  // Web apps (plugin webapps) are all the browser to a window's class;
  // their marks tell them apart. Listed again when a window opens, since a
  // web app may have been added since. Without the webapps plugin the
  // list stays empty and the browser's windows are the browser's.
  property var webApps: []
  Process {
    id: webAppList
    command: ["sh", Quickshell.env("HOME") + "/.local/share/mazapan/bin/webapp", "list"]
    running: true
    stdout: StdioCollector {
      onStreamFinished: root.webApps = text.split("\n").filter(line => line !== "").map(line => {
        // id, name, URL, icon: see webapps' `webapp list`.
        const [id, , url] = line.split("\t")
        return { id: id, mark: Apps.webAppMark(url) }
      })
    }
  }

  // Its desktop id when one is found, so it meets its pinned icon; else its
  // class.
  function appOf(toplevel) {
    const cls = (toplevel.wayland && toplevel.wayland.appId)
      || (toplevel.lastIpcObject && toplevel.lastIpcObject.class) || ""
    const web = Apps.webAppOf(cls, webApps)
    if (web) return "mazapan-webapp-" + web
    const entry = cls ? DesktopEntries.heuristicLookup(cls) : null
    return entry ? entry.id : cls
  }

  function address(toplevel) {
    const a = String(toplevel.address)
    return a.startsWith("0x") ? a : "0x" + a
  }

  // Every window, as plain data the dock's decisions can read.
  readonly property var windows: Hyprland.toplevels.values.map(t => ({
    toplevel: t,
    app: appOf(t),
    address: address(t),
    focused: t.activated,
    monitor: t.monitor ? t.monitor.name : "",
  }))

  // The order apps first showed up in, so icons don't swap places. Kept in
  // a file, so it outlives a reload of the shell (a theme change is one)
  // and a restart; nothing is written until it's been read, or the windows
  // there from the start would overwrite it.
  property var seen: []
  property var openBefore: []
  property bool orderRead: false
  // Written only when the order changes, not on every focus change.
  property string orderWritten: ""
  function rememberOrder(from) {
    const open = windows.map(w => w.app)
    seen = Apps.remember(from, openBefore, open)
    openBefore = open
    const text = JSON.stringify({ version: 1, seen: seen })
    if (orderRead && text !== orderWritten) {
      orderWritten = text
      orderFile.setText(text)
    }
  }
  onWindowsChanged: if (orderRead) rememberOrder(seen)
  FileView {
    id: orderFile
    path: Quickshell.env("HOME") + "/.local/state/mazapan/dock.json"
    atomicWrites: true
    printErrors: false
    onLoaded: {
      let kept = []
      try { kept = JSON.parse(text()).seen || [] } catch (e) {}
      root.orderRead = true
      root.rememberOrder(kept)
    }
    onLoadFailed: {
      root.orderRead = true
      root.rememberOrder([])
    }
  }
  Component.onCompleted: {
    Quickshell.execDetached(["mkdir", "-p", Quickshell.env("HOME") + "/.local/state/mazapan"])
    Hyprland.refreshToplevels()
  }

  // The dock's items on one screen: { app, pinned, windows, focused }.
  function itemsFor(monitorName) {
    const own = settings.this_screen_only ? windows.filter(w => w.monitor === monitorName) : windows
    return Apps.arrange(pinned, own, seen)
  }

  // --- window places, for getting out of the way ---------------------------

  // Hyprland's snapshot of where each window is goes stale as windows open,
  // move and scroll along the strip; taken again a moment after anything
  // happens (a title changing moves nothing). The moment lets the
  // strip's own animation end first.
  Connections {
    target: Hyprland
    function onRawEvent(event) {
      if (event.name === "windowtitle" || event.name === "windowtitlev2") return
      if (event.name === "openwindow") webAppList.running = true
      placesLater.restart()
    }
  }
  Timer {
    id: placesLater
    interval: Theme.duration + 80
    onTriggered: Hyprland.refreshToplevels()
  }

  // --- what can be done ----------------------------------------------------

  function entry(app) {
    return DesktopEntries.byId(app)
  }
  function name(app) {
    const e = entry(app)
    return e ? e.name : app
  }

  // Through the palette's launcher, which says so when the app doesn't
  // open (its program isn't there, it quits at once).
  readonly property string launcher: Quickshell.env("HOME") + "/.local/share/mazapan/bin/palette-launch"
  function launch(app) {
    const e = entry(app)
    const args = e ? Array.from(e.command || []) : []
    if (args.length === 0) return
    Quickshell.execDetached({
      command: ["sh", launcher, e.name].concat(e.runInTerminal ? ["--in", "xdg-terminal-exec"] : [], ["--"], args),
      workingDirectory: e.workingDirectory || "",
    })
  }

  // A new window of an app that has one open. Many apps run once and only
  // raise their window when started again (Text Editor, Files); the action
  // apps name new-window (the usual name, Firefox's and Chromium's too)
  // opens one in each. Apps without it are started again.
  function newWindowAction(e) {
    return e ? Array.from(e.actions || []).find(a => a.id === "new-window") ?? null : null
  }
  function newWindow(app) {
    const action = newWindowAction(entry(app))
    if (action) action.execute()
    else launch(app)
  }

  // Hyprland brings a focused window into view: its workspace, and on the
  // strip of columns, its column, wherever it was. It also takes the pointer
  // there (cursor:no_warps); keepPointerAt, a point on the desktop, puts
  // it back, so going through windows with the wheel stays on the dock.
  function focus(window, keepPointerAt) {
    Hyprland.dispatch(`hl.dsp.focus({ window = "address:${window.address}" })`)
    if (keepPointerAt)
      Hyprland.dispatch(`hl.dsp.cursor.move({ x = ${Math.round(keepPointerAt.x)}, y = ${Math.round(keepPointerAt.y)} })`)
  }
  function close(window) {
    Hyprland.dispatch(`hl.dsp.window.close({ window = "address:${window.address}" })`)
  }

  // Kept through mazapan, like any setting: in config.toml, so it travels
  // to another machine, and `mazapan undo` takes it back.
  function setPinned(app, on) {
    const list = Apps.pin(pinned, app, on)
    pinnedNow = list
    Quickshell.execDetached(["mazapan", "apply", "--set", "{{ plugin }}.pinned=" + JSON.stringify(list)])
  }
}
