// Generated by mazapan (plugin {{ plugin }}).
//
// The dock on one screen: a card at the bottom, centered, with the
// palette's button, the pinned apps, a hairline, and the other apps with
// windows. How it gets out of the way is the visibility setting:
//   always  it stays, and windows leave it room
//   smart   it slides away while a window sits where it would be
//   auto    it slides away until the pointer reaches the bottom edge
// Away, the bottom edge of the screen brings it back.

import QtQuick
import Quickshell
import Quickshell.Wayland
import Quickshell.Hyprland
import qs
import "Apps.js" as Apps

PanelWindow {
  id: win

  property bool on: true

  readonly property string mode: DockService.settings.visibility
  readonly property int iconSize: DockService.settings.icon_size
  readonly property var mon: Hyprland.monitorFor(screen)
  readonly property var items: DockService.itemsFor(mon ? mon.name : "")
  readonly property var pinnedItems: items.filter(i => i.pinned)
  readonly property var openItems: items.filter(i => !i.pinned)

  // Windows on this screen's workspace, where they are on the desktop.
  readonly property var placed: {
    const ws = mon ? mon.activeWorkspace : null
    if (!ws) return []
    return Hyprland.toplevels.values
      .filter(t => t.workspace && t.workspace.id === ws.id && t.lastIpcObject && t.lastIpcObject.at)
      .map(t => {
        const ipc = t.lastIpcObject
        return { x: ipc.at[0], y: ipc.at[1], width: ipc.size[0], height: ipc.size[1], fullscreen: ipc.fullscreen > 0 }
      })
  }
  // The card's place on the desktop, where it is when out.
  readonly property var place: ({
    x: (mon ? mon.x : 0) + (width - card.width) / 2,
    y: (mon ? mon.y : 0) + height - card.height - Theme.gapOut,
    width: card.width,
    height: card.height,
  })
  readonly property bool covered: Apps.covered(placed, place)

  // The pointer on the card or the edge, kept a moment after it leaves so
  // the dock doesn't flicker away on the way to it.
  property bool pointerIn: false
  // The button whose menu or windows are out: the dock stays meanwhile,
  // though the pointer has gone up to them.
  property Item holder: null
  readonly property bool busy: holder !== null && holder.busy
  function hold(button) {
    if (button.busy) holder = button
    else if (holder === button) holder = null
  }

  readonly property bool out: on && (mode === "always" || pointerIn || busy || (mode === "smart" && !covered))

  anchors {
    bottom: true
    left: true
    right: true
  }
  implicitHeight: card.height + Theme.gapOut * 2
  // Always there, it takes its room from the windows; else it floats.
  exclusionMode: mode === "always" && on ? ExclusionMode.Auto : ExclusionMode.Ignore
  WlrLayershell.namespace: "mazapan-dock"
  WlrLayershell.keyboardFocus: WlrKeyboardFocus.None
  color: "transparent"
  visible: on
  // Only the bottom edge takes the pointer, and while the dock is out, the
  // card and the gap under it too: going from the card down to the edge
  // never leaves the dock, so it doesn't slide away and back.
  mask: Region {
    item: edge
    Region { item: reach }
  }

  Item {
    id: edge
    anchors {
      left: parent.left
      right: parent.right
      bottom: parent.bottom
    }
    height: 2
  }
  Item {
    id: reach
    x: card.x
    y: card.y
    width: win.out ? card.width : 0
    height: win.out ? win.height - card.y : 0
  }

  HoverHandler {
    onHoveredChanged: {
      if (hovered) {
        linger.stop()
        win.pointerIn = true
      } else {
        linger.restart()
      }
    }
  }
  Timer {
    id: linger
    interval: 500
    onTriggered: win.pointerIn = false
  }

  Rectangle {
    id: card

    readonly property int pad: 6

    width: row.implicitWidth + pad * 2
    height: win.iconSize + 12 + pad * 2
    x: (win.width - width) / 2
    y: win.out ? win.height - height - Theme.gapOut : win.height + 1
    color: Theme.bgAlt
    border.color: Theme.border
    border.width: 1
    radius: Theme.radius
    // An empty dock (no apps pinned or open, no palette button) isn't
    // drawn at all.
    visible: row.implicitWidth > 0

    Behavior on y {
      enabled: Theme.motion
      NumberAnimation { duration: Theme.response; easing.type: Easing.OutQuint }
    }
    Behavior on width {
      enabled: Theme.motion
      NumberAnimation { duration: Theme.duration; easing.type: Easing.OutQuint }
    }

    Row {
      id: row
      x: card.pad
      y: card.pad
      spacing: 2

      // The palette: every app, and the rest of the desktop.
      Item {
        visible: DockService.settings.launcher
        width: win.iconSize + 8
        height: win.iconSize + 12

        Rectangle {
          anchors.fill: parent
          radius: Theme.radius
          color: launcherArea.containsMouse ? Theme.surface : "transparent"
        }
        Image {
          x: 4 + win.iconSize * 0.15
          y: 3 + win.iconSize * 0.15
          width: win.iconSize * 0.7
          height: width
          sourceSize: Qt.size(width, height)
          source: "file://" + Quickshell.shellPath("assets/mazapan.svg")
        }
        MouseArea {
          id: launcherArea
          anchors.fill: parent
          hoverEnabled: true
          onClicked: Quickshell.execDetached(["qs", "ipc", "-c", "mazapan", "call", "mazapan", "panel", "palette"])
        }
      }

      Repeater {
        // By app: a button keeps its menu or its windows out while the
        // list around it changes (a window opens, the focus moves).
        model: ScriptModel {
          values: win.pinnedItems
          objectProp: "app"
        }
        DockButton {
          required property var modelData
          item: modelData
          size: win.iconSize
          onBusyChanged: win.hold(this)
        }
      }

      // Between the kept apps and the rest.
      Rectangle {
        visible: win.openItems.length > 0 && (win.pinnedItems.length > 0 || DockService.settings.launcher)
        width: 9
        height: win.iconSize + 12
        color: "transparent"
        Rectangle {
          anchors.centerIn: parent
          width: 1
          height: parent.height * 0.6
          color: Theme.border
        }
      }

      Repeater {
        // By app: a button keeps its menu or its windows out while the
        // list around it changes (a window opens, the focus moves).
        model: ScriptModel {
          values: win.openItems
          objectProp: "app"
        }
        DockButton {
          required property var modelData
          item: modelData
          size: win.iconSize
          onBusyChanged: win.hold(this)
        }
      }
    }
  }
}
