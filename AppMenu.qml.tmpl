// Generated by mazapan (plugin {{ plugin }}).
//
// An app's menu, above its icon: the actions the app itself offers (a new
// private window, a new document), a new window, keeping it in the dock or
// taking it out, and closing its windows.

import QtQuick
import QtQuick.Layouts
import Quickshell
import qs
import "../kit"

PopupWindow {
  id: menu

  required property Item owner
  required property var item  // { app, pinned, windows, focused }
  required property var entry // its DesktopEntry, null when it has none

  // The app's own actions but its new window, which the row below runs.
  readonly property var appActions: entry ? Array.from(entry.actions || []).filter(a => a.id !== "new-window") : []
  readonly property int count: item.windows.length

  property double closedAt: 0
  function toggle() {
    if (visible) visible = false
    else if (Date.now() - closedAt > 250) visible = true
  }
  function done() {
    visible = false
  }

  visible: false
  onVisibleChanged: if (!visible) closedAt = Date.now()
  anchor.item: owner
  anchor.edges: Edges.Top
  anchor.gravity: Edges.Top
  implicitWidth: 260
  implicitHeight: card.implicitHeight + Theme.gapOut
  color: "transparent"
  grabFocus: true

  Rectangle {
    id: card
    width: parent.width
    implicitHeight: list.implicitHeight + 12
    color: Theme.surfaceRaised
    border.color: Theme.border
    border.width: 1
    radius: Theme.radius
    focus: true
    Keys.onEscapePressed: menu.done()

    ColumnLayout {
      id: list
      x: 1
      y: 6
      width: parent.width - 2
      spacing: 0

      Caption {
        Layout.leftMargin: 10
        Layout.bottomMargin: 4
        text: DockService.name(menu.item.app)
      }

      Repeater {
        model: menu.appActions

        ListRow {
          required property var modelData
          glyph: "󰁔"
          title: modelData.name
          onClicked: {
            modelData.execute()
            menu.done()
          }
        }
      }

      Rule {
        visible: menu.appActions.length > 0
        Layout.topMargin: 4
        Layout.bottomMargin: 4
      }

      ListRow {
        visible: menu.entry !== null
        glyph: "󰐕"
        title: menu.count === 0 ? {{ tq "menu.open" }} : {{ tq "menu.new_window" }}
        onClicked: {
          if (menu.count === 0) DockService.launch(menu.item.app)
          else DockService.newWindow(menu.item.app)
          menu.done()
        }
      }

      ListRow {
        visible: menu.entry !== null
        glyph: menu.item.pinned ? "󰐄" : "󰐃"
        title: menu.item.pinned ? {{ tq "menu.unpin" }} : {{ tq "menu.pin" }}
        onClicked: {
          DockService.setPinned(menu.item.app, !menu.item.pinned)
          menu.done()
        }
      }

      ListRow {
        visible: menu.count > 0
        glyph: "󰅖"
        title: menu.count === 1 ? {{ tq "menu.close" }} : {{ tq "menu.close_all" }}.arg(menu.count)
        onClicked: {
          for (const w of menu.item.windows) DockService.close(w)
          menu.done()
        }
      }
    }
  }
}
