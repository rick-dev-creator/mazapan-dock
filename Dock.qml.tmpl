// Generated by mazapan (plugin {{ plugin }}).
//
// The dock, one on each screen. The shell loads it as a panel, which is how
// a plugin gets a surface of its own; but it isn't one that opens over the
// windows and closes again: `open` stays false, so closing every open panel
// (SUPER + Q over one) leaves it be. The key shows or hides it:
//   qs ipc -c mazapan call mazapan panel dock

import QtQuick
import Quickshell
import "../components/dock"

Item {
  id: root

  readonly property bool open: false

  function toggle() {
    state.hidden = !state.hidden
  }
  function show() {
    state.hidden = false
  }
  function close() {}

  // Hidden by the key, it stays hidden across a reload of the shell.
  PersistentProperties {
    id: state
    reloadableId: "mazapan-dock"
    property bool hidden: false
  }

  Variants {
    model: Quickshell.screens

    DockWindow {
      required property var modelData
      screen: modelData
      on: !state.hidden
    }
  }
}
