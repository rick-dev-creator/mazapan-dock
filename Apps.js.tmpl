.pragma library
// Generated by mazapan (plugin dock).
//
// What the dock decides, as plain functions over plain data: which apps it
// shows and in what order, which app a window belongs to, which window
// comes next, whether a window sits where the dock is. Nothing here touches
// Quickshell or Hyprland, so tests/apps.test.mjs runs it under node.

// The part of a web app's window class that names it. The webapps plugin
// opens a site with Chromium's --app, whose window class is
// <browser>-<host>_<path, / as _>-<profile>: "https://web.whatsapp.com/"
// is in "chrome-web.whatsapp.com__-Default" as "-web.whatsapp.com__-".
// Host and path are read the way webapps' own host_of and path_of read them.
function webAppMark(url) {
  const m = /^[A-Za-z]+:\/\/([^/?#]*@)?([^/?#:]+)[^/?#]*([^?#]*)/.exec(url || "")
  if (!m) return ""
  const host = m[2].toLowerCase()
  const path = m[3] || "/"
  return "-" + host + "_" + path.replace(/\//g, "_") + "-"
}

// The web app a window belongs to (its id), or "" when it isn't one.
// webApps: [{ id, mark }].
function webAppOf(windowClass, webApps) {
  for (const w of webApps)
    if (w.mark && String(windowClass).includes(w.mark)) return w.id
  return ""
}

// The order apps first showed up in, kept as they come and go. A dock whose
// icons swap places when a window opens can't be learned by hand. An app
// that was open and closes leaves it (opened again, it goes at the end); one
// that opens and isn't in it goes at the end; the rest keep their place.
// An app in it that wasn't open before stays: at the start, windows are
// there a moment after the order is read.
function remember(seen, before, now) {
  const kept = seen.filter(app => now.includes(app) || !before.includes(app))
  for (const app of now)
    if (!kept.includes(app)) kept.push(app)
  return kept
}

// The open apps, in the order they showed up in.
function inOrder(seen, open) {
  return remember(seen, [], open).filter(app => open.includes(app))
}

// The dock's items: the pinned apps first, in their order, open or not;
// then every other app with a window, in the order they showed up.
// windows: [{ app, focused, … }], any other fields carried along.
// Each item: { app, pinned, windows, focused }.
function arrange(pinned, windows, seen) {
  const byApp = {}
  for (const w of windows)
    (byApp[w.app] = byApp[w.app] || []).push(w)
  const item = (app, isPinned) => {
    const own = byApp[app] || []
    return { app: app, pinned: isPinned, windows: own, focused: own.some(w => w.focused) }
  }
  const pinnedItems = pinned.map(app => item(app, true))
  const running = inOrder(seen, Object.keys(byApp))
    .filter(app => !pinned.includes(app))
    .map(app => item(app, false))
  return pinnedItems.concat(running)
}

// The window after (delta 1) or before (-1) the focused one, going round;
// the first when none of them has the focus.
function step(windows, delta) {
  if (windows.length === 0) return null
  const at = windows.findIndex(w => w.focused)
  if (at === -1) return windows[0]
  return windows[(at + delta + windows.length) % windows.length]
}

// Whether two rectangles ({ x, y, width, height }) share any area.
function overlaps(a, b) {
  return a.x < b.x + b.width && b.x < a.x + a.width
    && a.y < b.y + b.height && b.y < a.y + a.height
}

// Whether any window covers the dock's place. A full-screen window always
// does, wherever it says it is.
function covered(windows, dock) {
  return windows.some(w => w.fullscreen || overlaps(w, dock))
}

// A pinned list with one app added at the end, or taken out. Pinning one
// already there leaves it where it is.
function pin(pinned, app, on) {
  if (on) return pinned.includes(app) ? pinned : pinned.concat([app])
  return pinned.filter(p => p !== app)
}
