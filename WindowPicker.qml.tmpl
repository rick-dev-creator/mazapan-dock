// Generated by mazapan (plugin {{ plugin }}).
//
// An app's windows side by side above its icon, each live, with its title,
// to pick one: click to go to it (bringing it back when minimized), middle
// click to close it. Esc, or a click anywhere else, puts them away.

import QtQuick
import Quickshell
import Quickshell.Wayland
import qs

PopupWindow {
  id: picker

  required property Item owner
  required property var windows // the app's windows, as DockService has them

  // Every preview as tall; as wide as its window's shape asks, within
  // bounds, so a tall terminal and a wide browser both fill theirs.
  readonly property int thumbHeight: 150
  function thumbWidth(window) {
    const size = window.toplevel.lastIpcObject && window.toplevel.lastIpcObject.size
    const aspect = size && size[1] > 0 ? size[0] / size[1] : 16 / 10
    return Math.round(Math.max(100, Math.min(280, thumbHeight * aspect)))
  }
  readonly property int pad: 10

  property double closedAt: 0
  // A click on the icon that put it away doesn't bring it straight back.
  function toggle() {
    if (visible) visible = false
    else if (Date.now() - closedAt > 250) visible = true
  }

  visible: false
  onVisibleChanged: if (!visible) closedAt = Date.now()
  // The last window closed from here: nothing left to pick.
  onWindowsChanged: if (windows.length === 0) visible = false
  anchor.item: owner
  anchor.edges: Edges.Top
  anchor.gravity: Edges.Top
  implicitWidth: card.width
  implicitHeight: card.height + Theme.gapOut
  color: "transparent"
  grabFocus: true

  Rectangle {
    id: card
    width: row.implicitWidth + picker.pad * 2
    height: row.implicitHeight + picker.pad * 2
    color: Theme.surfaceRaised
    border.color: Theme.border
    border.width: 1
    radius: Theme.radius
    focus: true
    Keys.onEscapePressed: picker.visible = false

    Row {
      id: row
      x: picker.pad
      y: picker.pad
      spacing: picker.pad

      Repeater {
        model: ScriptModel {
          values: picker.windows
          objectProp: "address"
        }

        Column {
          id: thumb
          required property var modelData
          spacing: 6
          readonly property int thumbWidth: picker.thumbWidth(modelData)

          Rectangle {
            width: thumb.thumbWidth
            height: picker.thumbHeight
            color: Theme.bg
            border.width: 1
            border.color: thumbArea.containsMouse || thumb.modelData.focused ? Theme.accent : Theme.border
            radius: Theme.radius

            ScreencopyView {
              anchors.fill: parent
              anchors.margins: 2
              opacity: thumb.modelData.minimized ? 0.3 : 1
              // Only while it's out: a capture kept for a window that
              // closes later can bring the shell down (Quickshell 0.3).
              captureSource: picker.visible && thumb.modelData.toplevel.wayland ? thumb.modelData.toplevel.wayland : null
              live: picker.visible
              constraintSize: Qt.size(width, height)
            }

            // Minimized: Hyprland doesn't draw a window it doesn't show, so
            // what was last seen of it, dimmed, under the sign.
            Text {
              visible: thumb.modelData.minimized
              anchors.centerIn: parent
              text: "󰖰"
              color: Theme.fgMuted
              font.family: Theme.fontMono
              font.pointSize: 22
            }

            MouseArea {
              id: thumbArea
              anchors.fill: parent
              hoverEnabled: true
              acceptedButtons: Qt.LeftButton | Qt.MiddleButton
              onClicked: mouse => {
                if (mouse.button === Qt.MiddleButton) {
                  DockService.close(thumb.modelData)
                } else {
                  DockService.show(thumb.modelData)
                  picker.visible = false
                }
              }
            }
          }

          Text {
            width: thumb.thumbWidth
            text: thumb.modelData.toplevel.title
            textFormat: Text.PlainText
            elide: Text.ElideRight
            horizontalAlignment: Text.AlignHCenter
            color: thumb.modelData.focused ? Theme.accentText : Theme.fgMuted
            font.family: Theme.fontUi
            font.pointSize: Theme.fontSize - 1
          }
        }
      }
    }
  }
}
